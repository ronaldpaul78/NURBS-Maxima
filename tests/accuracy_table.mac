/* Recomputes Table 3 of docs/paper.md.  Run from the NURBS-Maxima folder:
     maxima -b tests/accuracy_table.mac                                    */
load(sconcat(pathname_directory(load_pathname), "../nurbs_maxima.mac"))$
C3 : nurbs_float(nurbs_circle(3,[1,2]))$
e1 : lmax(makelist(abs(nurbs_curve_curvature(C3,k/13.0)-1/3),k,0,13))$
e2 : abs(nurbs_curve_length(C3)-float(6*%pi))$
M : matrix([1,0,0,0],[0,2,0,1],[0,0,1,0],[0.5,0,0,1])$
Cr : nurbs_curve(3,[0,0,0,0,1/2,1,1,1,1],[[0,0,0],[1,2,1],[2,-1,2],[4,1,0],[5,3,1]],[1,2,1/2,1,3])$
Ct : nurbs_transform(Cr, M)$
proj(X):=block([h:[X[1],X[2],X[3],1].transpose(M)], h:list_matrix_entries(h), rest(h,-1)/last(h))$
e3 : lmax(makelist(lmax(abs(float(nurbs_curve_point(Ct,k/10.0)-proj(nurbs_curve_point(Cr,k/10.0))))),k,0,10))$
R:2$ r:1/2$ T : nurbs_float(nurbs_torus(R,r))$
Kex(X):=block([c:(sqrt(X[1]^2+X[2]^2)-R)/r],c/(r*(R+r*c)))$
e4 : lmax(flatten(makelist(makelist(abs(nurbs_gaussian_curvature(T,i/7.0,j/9.0)-Kex(nurbs_surface_point(T,i/7.0,j/9.0))),j,0,9),i,0,7)))$
e5 : abs(nurbs_surface_area(T)-float(4*%pi^2*R*r))$
e6 : abs(nurbs_surface_volume(T)-float(2*%pi^2*R*r^2))$
e7 : abs(nurbs_total_gaussian_curvature(nurbs_sphere(1))-float(4*%pi))$
e8 : abs(nurbs_total_gaussian_curvature(T))$
for e in [["circle r=3 curvature (14 pts)",e1],["circle r=3 length vs 6 pi",e2],["projective invariance (11 pts)",e3],["torus K vs analytic (8x10 grid)",e4],["torus area",e5],["torus volume",e6],["sphere int K dA - 4 pi",e7],["torus int K dA",e8]] do printf(true,"~a: ~,2e~%",e[1],e[2])$
