/* ==========================================================================
   NURBS-Maxima -- complete validation run
   --------------------------------------------------------------------------
   From the NURBS-Maxima folder:
       maxima -b tests/test_nurbs.mac
   or in wxMaxima:
       batch("C:/path/NURBS-Maxima/tests/test_nurbs.mac")$

   Part A runs the regression suite tests/rtest_nurbs.mac (Maxima's
   standard rtest format, stages 1-5).
   Part B compares NURBS-Maxima with reference values computed by geomdl
   (NURBS-Python) and stored in tests/reference_geomdl.mac, generated by
   python3 tests/compare_geomdl.py.  If that file is missing, Part B is
   skipped.  The opposite direction (Maxima -> JSON -> geomdl) is
   tests/crossval_export.mac + tests/crossval_geomdl.py.
   ========================================================================== */

nurbs_test_dir : pathname_directory(load_pathname)$
load(sconcat(nurbs_test_dir, "../nurbs_maxima.mac"))$

printf(true, "~%===== Part A: regression suite (rtest_nurbs.mac) =====~%")$
batch(sconcat(nurbs_test_dir, "rtest_nurbs.mac"), test)$

/* ---------------------------------------------------------- Part B */
t_pass : 0$  t_fail : 0$  t_failed : []$
t_dist(a, b) := lmax(cons(0.0, map(abs, flatten([float(a - b)]))))$
t_close(name, a, b, tol) := block([d: errcatch(t_dist(a, b))],
  if d # [] and is(d[1] <= tol) then (t_pass: t_pass + 1,
     printf(true, "  [OK]    ~a  (max. error = ~,2e)~%", name, d[1]))
  else (t_fail: t_fail + 1, t_failed: endcons(name, t_failed),
        printf(true, "  [FAIL]  ~a  (max. error = ~a)~%", name, if d = [] then "error" else d[1])))$

printf(true, "~%===== Part B: comparison with geomdl (NURBS-Python) =====~%")$
ref_file : sconcat(nurbs_test_dir, "reference_geomdl.mac")$
if file_search(ref_file) = false then
  printf(true, "  [SKIP]  reference file not found: run python3 tests/compare_geomdl.py~%")
else block([bsU, bsP, ratc, bez, circ, torf, sphf, bsurf],
  load(ref_file),
  printf(true, "  references generated with geomdl ~a~%", ref_geomdl_version),
  bsU : [0,0,0,0,1/3,2/3,1,1,1,1],
  bsP : [[0,0,0],[1,2,1],[2,-1,2],[4,1,0],[5,3,1],[7,0,2]],
  ratc : nurbs_curve(3, bsU, bsP, [1, 2, 0.5, 1, 3, 1]),
  bez : nurbs_bezier_curve([[0,0],[1,2],[3,3],[4,0]]),
  circ : nurbs_circle(1),
  torf : nurbs_float(nurbs_torus(2, 1/2)),
  sphf : nurbs_float(nurbs_sphere(1)),
  bsurf : nurbs_bezier_surface([[[0,0,0],[0,1,1],[0,2,0],[0,3,1]], [[1,0,1],[1,1,2],[1,2,1],[1,3,0]],
            [[2,0,0],[2,1,-1],[2,2,2],[2,3,1]], [[3,0,1],[3,1,0],[3,2,1],[3,3,0]]]),

  t_cmp_curve(name, C, ref) := t_close(sconcat("curve ", name, ": C, C', C'' at ", length(ref), " parameters"),
    map(lambda([row], nurbs_curve_derivs(C, row[1], 2)), ref), map(rest, ref), 1e-9),
  t_cmp_curve("cubic Bezier", nurbs_float(bez), ref_bezier),
  t_cmp_curve("rational circle", nurbs_float(circ), ref_circle),
  t_cmp_curve("cubic 3-D B-spline", nurbs_float(bspline_curve(3, bsU, bsP)), ref_bspline),
  t_cmp_curve("weighted cubic NURBS", nurbs_float(ratc), ref_rational),

  t_cmp_surf(name, S, ref) := t_close(sconcat("surface ", name, ": S, Su, Sv, Suu, Suv, Svv at ", length(ref), " points"),
    map(lambda([row], block([D: nurbs_surface_derivs(S, row[1], row[2], 2)],
      [D[1,1], D[2,1], D[1,2], D[3,1], D[2,2], D[1,3]])), ref),
    map(lambda([row], rest(row, 2)), ref), 1e-8),
  t_cmp_surf("bicubic Bezier", nurbs_float(bsurf), ref_bsurf),
  t_cmp_surf("rational torus", torf, ref_torus),
  t_cmp_surf("rational sphere", sphf, ref_sphere),

  t_close("torus unit normals", map(lambda([row], nurbs_surface_normal(torf, row[1], row[2])), ref_torus_normals),
    map(third, ref_torus_normals), 1e-10),
  t_close("bicubic Bezier unit normals", map(lambda([row], nurbs_surface_normal(nurbs_float(bsurf), row[1], row[2])), ref_bsurf_normals),
    map(third, ref_bsurf_normals), 1e-10),

  block([ic2: nurbs_interpolate_curve(ref_interp_Q, 3)],
    t_close("global interpolation (LU): knot vector", ic2@knots, ref_interp_knots, 1e-12),
    t_close("global interpolation (LU): control points", ic2@ctrlpts, ref_interp_ctrlpts, 1e-9)),

  block([ci2: nurbs_curve_insert_knot(nurbs_float(ratc), 0.5, 2)],
    t_close("knot insertion: knot vector", ci2@knots, ref_insert_knots, 1e-14),
    t_close("knot insertion: homogeneous control points", nurbs_curve_ctrlptsw(ci2), ref_insert_ctrlptsw, 1e-12)),

  /* geomdl.operations.length_curve approximates the length by a polyline
     (O(h^2) error); NURBS-Maxima uses Gauss-Legendre quadrature, which
     rtest_nurbs.mac checks against 2*pi to 1e-10.                        */
  t_close("arc length vs geomdl polyline (tolerance 5e-3)",
    nurbs_curve_length(bspline_curve(3, bsU, bsP)), ref_bspline_length, 5e-3))$

printf(true, "~%Part B: ~d passed, ~d failed~%", t_pass, t_fail)$
if t_fail > 0 then printf(true, "Failed: ~a~%", t_failed)$
